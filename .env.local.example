# ─────────────────────────────────────────────────────────────
# 環境變數範本
#
# 使用方式：
#   1. 把這個檔案複製一份，命名為 .env.local（不會被 git 追蹤）
#   2. 到 Firebase 主控台把下面的值填進去（SETUP.md 有逐步教學）
#   3. 重新啟動 npm run dev
#
# 沒有填這些值時，網站仍可正常運作，作品會顯示 src/data/projects.ts
# 裡的預設資料，但後台與聯絡表單收信功能不會啟用。
# ─────────────────────────────────────────────────────────────

# ── Firebase 前端設定（登入頁用）──────────────────────────────
# Firebase 主控台 → 專案設定 → 一般 → 你的應用程式 → SDK 設定與配置
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Firebase 後端設定（Admin SDK，讀寫資料用）────────────────
# Firebase 主控台 → 專案設定 → 服務帳戶 → 產生新的私密金鑰 → 下載 JSON
# 然後把整個 JSON 檔用 base64 編碼成「一行字串」貼在這裡。
# 產生方式（Mac 終端機）：
#   base64 -i ~/Downloads/你的金鑰檔.json | pbcopy
# 這樣 base64 字串就複製到剪貼簿了，直接貼上即可。
FIREBASE_SERVICE_ACCOUNT_KEY=

# Storage 儲存桶名稱（選用，保留相容既有 Firebase Storage 圖片）
# Firebase 主控台 → Storage 頁面最上方會看到 gs://xxxxx 這個名字
FIREBASE_STORAGE_BUCKET=

# ── Vercel Blob（圖片上傳的儲存後端）─────────────────────────
# 後台上傳的圖片會存到 Vercel Blob 的公開 CDN。
# Vercel：專案 → Storage → 建立/連結 Blob store 後會自動注入此變數。
# 本機開發：用 `vercel env pull .env.local`，或到 Blob store 頁面複製 token 貼在這裡。
BLOB_READ_WRITE_TOKEN=

# ── Email 通知（選用，用你自己的 Gmail 寄送聯絡表單通知）─────
# 不需要註冊任何寄信服務，但 Google 帳戶必須先開啟兩步驟驗證：
#   1. https://myaccount.google.com/security → 開啟「兩步驟驗證」
#   2. https://myaccount.google.com/apppasswords → 產生一組「應用程式密碼」
#   3. 把那 16 碼（可含空白）貼到 GMAIL_APP_PASSWORD
# 這組密碼只能用來寄信，不等於你的 Google 密碼，隨時可以撤銷。
GMAIL_USER=你的帳號@gmail.com
GMAIL_APP_PASSWORD=

# 收到聯絡表單時要通知誰。可以填多個，用逗號分隔：
#   CONTACT_NOTIFY_EMAIL=me@gmail.com,同事A@gmail.com,同事B@gmail.com
# 留空則預設寄給 GMAIL_USER 自己。
# 收件人不需要做任何設定或授權，填地址就收得到。
CONTACT_NOTIFY_EMAIL=

# 設定完可以先測試：npm run test:email

# Google Analytics 4 評估 ID（格式 G-XXXXXXXXXX）— 留空則不載入 GA
NEXT_PUBLIC_GA_ID=
