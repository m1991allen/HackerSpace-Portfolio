# ─────────────────────────────────────────────────────────────
# 環境變數範本
#
# 使用方式：
#   1. 把這個檔案複製一份，命名為 .env.local（不會被 git 追蹤）
#   2. 到 Firebase 主控台把下面的值填進去（SETUP.md 有逐步教學）
#   3. 重新啟動 npm run dev
#
# 沒有填這些值時，網站仍可正常運作，作品會顯示 src/data/projects.ts
# 裡的預設資料，但後台與聯絡表單收信功能不會啟用。
# ─────────────────────────────────────────────────────────────

# ── Firebase 前端設定（登入頁用）──────────────────────────────
# Firebase 主控台 → 專案設定 → 一般 → 你的應用程式 → SDK 設定與配置
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Firebase 後端設定（Admin SDK，讀寫資料用）────────────────
# Firebase 主控台 → 專案設定 → 服務帳戶 → 產生新的私密金鑰 → 下載 JSON
# 然後把整個 JSON 檔用 base64 編碼成「一行字串」貼在這裡。
# 產生方式（Mac 終端機）：
#   base64 -i ~/Downloads/你的金鑰檔.json | pbcopy
# 這樣 base64 字串就複製到剪貼簿了，直接貼上即可。
FIREBASE_SERVICE_ACCOUNT_KEY=

# Storage 儲存桶名稱，通常是 你的專案ID.appspot.com 或 你的專案ID.firebasestorage.app
# Firebase 主控台 → Storage 頁面最上方會看到 gs://xxxxx 這個名字
FIREBASE_STORAGE_BUCKET=

# ── Email 通知（選用，用 Resend 寄送聯絡表單通知）────────────
# 到 https://resend.com 註冊 → API Keys → 建立一組
RESEND_API_KEY=
# 收到聯絡表單時要通知哪個信箱（你的信箱）
CONTACT_NOTIFY_EMAIL=
# 寄件人地址。還沒設定自訂網域前，可先用 Resend 提供的 onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
